# ---------------------------------------------------------------------------
# Supabase — guarda os acessos da demo (tabela "hits").
# Dashboard do Supabase -> Settings -> API Keys (antigo Settings -> API).
# ---------------------------------------------------------------------------

# Project URL, ex.: https://abcdefgh.supabase.co
SUPABASE_URL=

# Chave SECRETA (só servidor). Use UMA das duas:
#  - SUPABASE_SERVICE_ROLE_KEY : chave legada "service_role"
#  - SUPABASE_SECRET_KEY       : chave nova "sb_secret_..."
# NUNCA exponha esta chave no navegador nem faça commit dela.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Chave PÚBLICA (anon/publishable). Vai para o navegador, usada no login do
# painel. É segura de expor. Settings -> API Keys no Supabase.
SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — CAPTCHA do login do painel (opcional).
# Site key PÚBLICA (vai para o navegador). A Secret key NÃO entra aqui: fica só
# no Supabase (Authentication -> Attack Protection), que valida o token.
# Vazia = login sem CAPTCHA. Para ativar: cadastre a Site key aqui/no Vercel E
# ligue o "Enable CAPTCHA protection" no Supabase (ver README).
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY=
