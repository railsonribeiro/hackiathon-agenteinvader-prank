# ---------------------------------------------------------------------------
# Banco de dados (Upstash Redis) — guarda o contador de acessos da demo.
# Crie um banco gratuito em https://upstash.com e copie as credenciais REST.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Se você conectar o banco pela integração "Upstash" do Marketplace do Vercel,
# ele pode criar estas variáveis no lugar das de cima. O código aceita as duas.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Opcional: protege o painel de métricas (/dashboard e /api/metrics).
# Se definido, acesse o painel em /dashboard?token=SEU_TOKEN
# ---------------------------------------------------------------------------
DASHBOARD_TOKEN=
